# Copy this file to .env and fill in the values.

PORT=5030

# Values matching server/docker-compose.yml, for development only
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=blog_db

# Required. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Number of reverse proxies in front of the API (0 in development)
TRUST_PROXY=0
